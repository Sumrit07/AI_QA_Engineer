      "Original: kal mujhe Jaipur jana hai\n",
      "English: tomorrow i have to go to jaipur\n"
     ]
    }
   ],
   "source": [
    "from googletrans import Translator\n",
    "\n",
    "translator = Translator()\n",
    "\n",
    "hinglish_text = \"kal mujhe Jaipur jana hai\"\n",
    "\n",
    "translated = await translator.translate(hinglish_text, dest=\"en\")\n",
    "\n",
    "print(\"Original:\", hinglish_text)\n",
    "print(\"English:\", translated.text)"
   ]
  },
